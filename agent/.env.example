# Variables d'environnement pour le projet Encyclopédie Automobile

# 🔑 OBLIGATOIRE : Votre clé API Google Gemini
# Obtenez-la sur : https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 🔑 SECOND FOURNISSEUR (optionnel) : quota indépendant de Gemini
# Clé sur : https://build.nvidia.com — ~182 marques à collecter, le gratuit Gemini ne suffit pas
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
AGENT_LLM_BACKEND=gemini         # gemini | nvidia (ou --backend nvidia)

# ⚙ Paramètres de l'agent (optionnels)
AGENT_DELAY_SECONDS=1.5          # Délai entre les requêtes Gemini
AGENT_MAX_RETRIES=3              # Nombre de tentatives max en cas d'erreur
AGENT_BATCH_SIZE=10              # Nombre de marques traitées par batch

# 🗄 Base de données
# — Sans DATABASE_URL : SQLite local (../data/cars.db)
# — Avec Supabase : URI Postgres (Settings → Database → Connection string → URI)
#   Exemple : postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_DB_URL=

# Ancien chemin SQLite (si pas de DATABASE_URL)
DATABASE_PATH=../data/cars.db
